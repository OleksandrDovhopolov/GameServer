# Copy to terraform.tfvars and put your own address in.
# terraform.tfvars is gitignored — the real file never reaches the repository.
#
#   curl ifconfig.me
#
# A home address is usually dynamic: when SSH stops connecting for no apparent
# reason, this is the first thing to re-check.
allowed_ssh_cidr = "203.0.113.10/32"

