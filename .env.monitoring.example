# Monitoring stack settings. Copy to .env.monitoring on the server and replace every secret.
GRAFANA_ADMIN_PASSWORD=replace-with-long-random-password
GRAFANA_ROOT_URL=https://grafana.bobak.me.uk

# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB from .env.vps.
# Kept as three values rather than one URL so that special characters in the password
# (/ + @ # %) cannot break it.
POSTGRES_EXPORTER_URI=postgres:5432/gameserver_staging?sslmode=disable
POSTGRES_EXPORTER_USER=gameserver
POSTGRES_EXPORTER_PASS=replace-with-the-password-from-env-vps
