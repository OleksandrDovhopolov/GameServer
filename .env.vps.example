# VPS staging defaults. Copy to .env.vps on the server and replace every secret.
POSTGRES_DB=gameserver_staging
POSTGRES_USER=gameserver
POSTGRES_PASSWORD=replace-with-long-random-password

ADMIN_USER=replace-with-admin-user
ADMIN_PASS=replace-with-long-random-admin-password

AUTH_JWT_SIGNING_KEY=replace-with-long-random-jwt-signing-key-32-bytes-minimum
