{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Postgres": {
    "ConnectionString": "Host=localhost;Port=5432;Database=game_server;Username=postgres;Password=postgres;Include Error Detail=true"
  },
  "SaveStorage": {
    "Provider": "Redis"
  },
  "Auth": {
    "Mode": "Disabled",
    "JwtSigningKey": "",
    "KeyId": "default",
    "Issuer": "gameserver",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 90,
    "AllowLegacyClaim": true,
    "AnonymousLimitPerMinute": 20,
    "RefreshLimitPerMinute": 60
  },
  "AdminAuth": {
    "Username": "admin",
    "Password": "admin",
    "AllowedIps": ""
  },
  "AdminTools": {
    "AllowRedisFlush": false
  },
  "GooglePlayBilling": {
    "Enabled": false,
    "PackageName": "",
    "ServiceAccountJson": "",
    "ServiceAccountKeyFile": "",
    "ApplicationName": "GameServer.Api",
    "HttpTimeoutSeconds": 30
  },
  "AllowedHosts": "*"
}
